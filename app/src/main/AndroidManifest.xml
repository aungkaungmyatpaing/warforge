<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Four permissions, and the game is fully playable with all of them denied or with
        the device in flight mode. Nothing here reads contacts, storage, location or the
        camera, and nothing is requested at runtime - these are all install-time.
    -->

    <!-- Serving ads, and fetching version.json to see whether an update exists. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required by the Play Services ads SDK; it checks connectivity before requesting. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Haptics on a correct or incorrect placement. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
        The advertising id. Declaring it is mandatory for any app targeting API 33+ that
        uses AdMob; leaving it out does not make the app collect less, it just makes the
        SDK fail. It is declared on the Data safety form as collected and shared.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application
        android:name=".WarforgeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Warforge">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|screenSize|smallestScreenSize|screenLayout|orientation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MuseumActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|screenSize|smallestScreenSize|screenLayout|orientation" />

        <activity
            android:name=".ui.BuildActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|screenSize|smallestScreenSize|screenLayout|orientation" />
    </application>
</manifest>
