<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/board">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/bg_panel"
            android:paddingStart="4dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back_to_hangar" />

            <TextView
                android:id="@+id/partLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/drag_hint"
                android:textColor="@color/ink_dim"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <ImageButton
                android:id="@+id/restart"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_restart"
                android:contentDescription="@string/restart" />

            <LinearLayout
                android:id="@+id/hintBtn"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_ghost_button"
                android:paddingStart="10dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_hint"
                    android:contentDescription="@string/hint" />

                <TextView
                    android:id="@+id/hintLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="@string/hint"
                    android:textColor="@color/ink"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progressTint="@color/accent"
            android:progressBackgroundTint="@color/stroke" />

        <com.naymyo.warforge.game.Assembly3DView
            android:id="@+id/boardView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/adSlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- What you just fitted, and why it is there. The educational payoff of the
         build sits here: you have the engine in your hand, so this is the moment the
         note about it lands. -->
    <LinearLayout
        android:id="@+id/partCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="96dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/partName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/partDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/steel"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <com.naymyo.warforge.ui.MaxHeightScrollView
            android:id="@+id/partScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/partInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_dim"
                android:textSize="13sp"
                android:lineSpacingExtra="5dp" />
        </com.naymyo.warforge.ui.MaxHeightScrollView>
    </LinearLayout>

    <include
        android:id="@+id/victory"
        layout="@layout/overlay_victory"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
